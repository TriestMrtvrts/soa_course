@startuml c4-option-a
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title Вариант A. Event-driven оркестратор (Kafka + PostgreSQL state machine) — C4 Container

Person(client, "Клиент банка", "Мобильное приложение, SMS, email")
System_Ext(products, "Продуктовые сервисы", "Платежи, переводы, карты, кредиты")
System_Ext(push, "Push-провайдеры", "FCM, APNs, RuStore Push, HMS")
System_Ext(sms, "SMS-агрегаторы A и B", "HTTP/SMPP, DLR webhooks")
System_Ext(email, "Email-провайдеры A и B", "SMTP/HTTP API, event webhooks")

System_Boundary(np, "Notification Platform — контур критичных уведомлений") {
  Container(ingest, "Ingest API", "Go, gRPC + REST", "Приём, валидация, идемпотентность по (source, event_id), запись в БД + outbox")
  ContainerDb(statedb, "Delivery State DB", "PostgreSQL 16, Patroni, 4 шарда по user_id", "notifications, attempts, deadlines, outbox; партиции по дням")
  Container(relay, "Outbox Relay", "Debezium (Kafka Connect)", "CDC outbox -> Kafka, at-least-once")
  ContainerQueue(kafka, "Kafka", "3 брокера/ЦОД, RF=3, min.insync=2", "notifications.critical, channel.{push,sms,email}.critical, delivery.events")
  Container(orch, "Delivery Orchestrator", "Go, Kafka consumer group", "Конечный автомат уведомления: план каналов, попытки, failover, CAS по version")
  Container(sched, "Failover Scheduler", "Go", "Опрос deadlines (FOR UPDATE SKIP LOCKED) каждые 100 мс, публикует timeout-события")
  Container(prefs, "Preference & Contact Service", "Java/Spring", "Каналы, согласия, контакты, push-токены")
  ContainerDb(redis, "Preferences cache", "Redis Cluster", "Настройки и контакты, TTL + инвалидация по событиям")
  Container(pushw, "Push Sender", "Go workers", "collapse-id = notification_id, circuit breaker")
  Container(smsw, "SMS Sender", "Go workers", "Маршрутизация A/B по здоровью и цене, client_msg_id = attempt_id")
  Container(emailw, "Email Sender", "Go workers", "Резервный канал")
  Container(receipts, "Receipt Gateway", "Go, HTTPS", "DLR/webhooks провайдеров + Ack API приложения")
  Container(inbox, "Inbox Service", "Go + ScyllaDB", "История уведомлений в приложении")
  ContainerDb(ch, "Delivery Analytics", "ClickHouse", "Все события доставки, 5 лет, отчёты и стоимость")
  Container(obs, "Observability", "OpenTelemetry, Prometheus, Grafana, Alertmanager", "SLO, burn-rate алерты, трейсинг по notification_id")
}

Rel(products, ingest, "SendNotification", "gRPC, mTLS")
Rel(ingest, statedb, "INSERT notification + outbox", "1 транзакция")
Rel(relay, statedb, "читает WAL outbox")
Rel(relay, kafka, "notifications.critical")
Rel(kafka, orch, "notifications.critical, delivery.events, timeouts")
Rel(orch, statedb, "CAS переходы, попытки, deadlines")
Rel(orch, prefs, "настройки, контакты", "gRPC")
Rel(prefs, redis, "cache-aside")
Rel(orch, kafka, "channel.*.critical")
Rel(sched, statedb, "due deadlines")
Rel(sched, kafka, "timeout events")
Rel(kafka, pushw, "channel.push.critical")
Rel(kafka, smsw, "channel.sms.critical")
Rel(kafka, emailw, "channel.email.critical")
Rel(pushw, push, "send", "HTTP/2")
Rel(smsw, sms, "send", "HTTP/SMPP")
Rel(emailw, email, "send", "HTTP API")
Rel(sms, receipts, "DLR", "webhook")
Rel(email, receipts, "events", "webhook")
Rel(client, receipts, "ack получения push", "HTTPS")
Rel(receipts, kafka, "delivery.events")
Rel(orch, inbox, "запись в inbox")
Rel(kafka, ch, "delivery.events", "Kafka engine")
Rel(push, client, "push")
Rel(sms, client, "SMS")
Rel(email, client, "email")
SHOW_LEGEND()
@enduml
